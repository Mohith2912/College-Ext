{
  "name": "@aetheria/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./seed": { "types": "./dist/seed.d.ts", "import": "./dist/seed.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/seed.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "seed": "tsx src/run-seed.ts"
  },
  "dependencies": { "@prisma/client": "6.19.0" },
  "devDependencies": {
    "@types/node": "22.20.4",
    "prisma": "6.19.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
